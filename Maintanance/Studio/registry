#!/bin/bash
set -e
studio_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
release_dir="$studio_dir/releases/0.1.0-rc.12"
repository_dir=$(CDPATH= cd -- "$studio_dir/../.." && pwd)

# Match the project identity shown by the deployed Web page. Keep stdout JSON intact.
if [ "${2:-}" = briefing ] && { [ "${1:-}" = round ] || [ "${1:-}" = waiting ]; }; then
  if [ -r "$studio_dir/generated/project-name.txt" ]; then
    printf '対象ライブラリ: %s\n' "$(cat "$studio_dir/generated/project-name.txt")" >&2
  fi
fi

# Keep explicit options; only supply deployment defaults.
original=("$@")
defaults=()
add_default() {
  local arg
  for arg in "${original[@]}"; do
    [ "$arg" = -- ] && break
    case "$arg" in "$1"|"$1"=*) return 0 ;; esac
  done
  defaults+=("$1" "$2")
}
if [ "${1:-}" = round ] && { [ "${2:-}" = progress-start ] || [ "${2:-}" = progress-end ]; }; then
  command=$2
  shift 2
  add_default --port 8089
  exec "$release_dir/bin/registry" round "$command" "${defaults[@]}" "$@"
fi
case "${1:-}" in
  studio)
    shift
    add_default --db "$studio_dir/data/registry.sqlite3"
    add_default --documents "$studio_dir/data/registry.sqlite3"
    add_default --output "$studio_dir/generated"
    add_default --root "$release_dir"
    add_default --files-root "$repository_dir"
    exec "$release_dir/bin/registry" studio "${defaults[@]}" "$@"
    ;;
  task|doc|round|member|queue|template)
    # Group help has no DB option. Leaf commands share --db.
    if [ "$#" -ge 2 ] && [[ "$2" != -* ]] && [ "$2" != help ]; then
      group=$1
      command=$2
      shift 2
      add_default --db "$studio_dir/data/registry.sqlite3"
      exec "$release_dir/bin/registry" "$group" "$command" "${defaults[@]}" "$@"
    fi
    ;;
esac
# Database init/upgrade deliberately require an explicit target.
# Waiting and whiteboard use the CLI's default port 8088.
exec "$release_dir/bin/registry" "$@"
