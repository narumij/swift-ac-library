#!/usr/bin/env python3
"""Read current task state; never changes tasks or grants permission."""
from pathlib import Path
import json
import re
import subprocess
import sys
studio = Path(__file__).resolve().parent
registry = str(studio / "registry")
print("対象: swift-ac-library", flush=True)
print("DB: " + str(studio / "data/registry.sqlite3"), flush=True)
# Use the CLI for both display labels and permanent-task classification.
rows = json.loads(subprocess.check_output([registry, "task", "ls", "--json-output"], text=True))
lines = subprocess.check_output([registry, "task", "ls"], text=True).splitlines()
if len(rows) != len(lines):
    sys.exit("読取り中に一覧が変わりました。再実行してください。")
for title, states, permanent in [
    ("恒久タスク（整理の入口）", None, True),
    ("現在の作業対象（正本の範囲・条件を確認）", {"ACTIVE"}, False),
    ("未採用の候補（自動着手しない）", {"PROPOSED"}, False),
    ("待ち・保留（状態を確認）", {"WAITING_USER", "WAITING_EXTERNAL", "FROZEN", "USER_ONLY"}, False),
]:
    print("\n" + title)
    found = False
    for row, line in zip(rows, lines):
        if row["permanent"] != permanent or (states is not None and row["state"] not in states):
            continue
        found = True
        print(line)
        label = line.split(" ", 1)[0]
        if re.fullmatch(r"[A-Z][A-Z0-9_]*-[0-9]+", label):
            print("  正本: Maintanance/Studio/registry doc show " + label + " --mainline")
    if not found:
        print("（なし）")
print("\n完了・除外・アーカイブも含む一覧: Maintanance/Studio/registry task ls")
print("手順: Maintanance/Studio/WORK_ENTRY.md")
